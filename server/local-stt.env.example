# Local preview: audio stays on the desktop. Only translations use the API.
STT_MODE=local
TRANSLATION_BASE_URL=https://api.x.ai/v1
TRANSLATION_API_KEY=
# General-purpose non-reasoning model; verify availability for your xAI account.
TRANSLATION_MODEL=grok-4.20-0309-non-reasoning
TRANSLATION_OPTIONS_JSON='{"max_tokens":256}'
BIND_ADDRESS=127.0.0.1:18080
DATABASE_PATH=local-stt-usage.sqlite3
MAX_CONCURRENT_REQUESTS=4
UPSTREAM_TIMEOUT_SECONDS=15
